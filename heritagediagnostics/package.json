{
  "name": "heritagediagnostics",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:build:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "ios:build:production": "npx eas-cli@latest build --platform ios --profile production",
    "lint": "eslint .",
    "start": "react-native start",
    "web": "vite --config vite.config.mjs",
    "web:build": "vite build --config vite.config.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "backend": "npm --prefix ../backend run dev:memory",
    "backend:start": "npm --prefix ../backend start",
    "backend:seed": "npm --prefix ../backend run seed",
    "backend:test": "npm --prefix ../backend test",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/mukta": "^5.2.8",
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-firebase/app": "^25.1.0",
    "@react-native-firebase/messaging": "^25.1.0",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.8",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-tts": "^4.1.1",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3",
    "vite": "^8.1.4"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
