<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon. Android throws away every colour here and keeps only the
     alpha channel, tinting the result with notification_color — so this is a
     silhouette by design, not an unfinished asset. Handing it the full-colour crest
     instead is what turns a notification icon into a white square on Android 5+.

     A medical cross reads at 24dp in a crowded status bar; the crest does not. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M9,3 h6 v6 h6 v6 h-6 v6 h-6 v-6 h-6 v-6 h6 z" />
</vector>
